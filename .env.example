# Copy this file to .env and change the password:
#   cp .env.example .env
MONITOR_PASSWORD=change_me

# Initial admin login (created only when the database has no users)
# MONITOR_ADMIN_USERNAME=admin
# MONITOR_ADMIN_PASSWORD=override_password

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional settings
# MONITOR_SESSION_TTL_SECONDS=604800
# Cookies are marked Secure by default (requires HTTPS on the reverse proxy).
# Set to false only for plain-HTTP testing.
# MONITOR_COOKIE_SECURE=true
# MONITOR_DB_PATH=/app/data/monitor.db
# MONITOR_CONFIG_PATH=/app/data/config.json
# MONITOR_LOG_PATH=/app/data/monitor.log
# LOG_FORMAT=json
